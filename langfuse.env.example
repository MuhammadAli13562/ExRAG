############################################
# Langfuse (self-hosted) - local/dev example
############################################

# Tracing toggle for ExRAG
EXRAG_TRACING=langfuse

# Langfuse API (from Langfuse UI -> Settings -> API keys)
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk_XXXXXXXXXXXXXXXXXXXXXXXX
LANGFUSE_SECRET_KEY=sk_XXXXXXXXXXXXXXXXXXXXXXXX

# Optional
LANGFUSE_PROJECT=ExRAG

# Payload size (increase if you want deeper payloads in Langfuse)
EXRAG_LANGFUSE_MAX_CHARS=20000


